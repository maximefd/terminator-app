# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS / éditeurs
.DS_Store
.idea/
.vscode/

# Variables d'environnement (seul le modèle est versionné)
.env
.env.*
!.env.example
!.env.production.example

# Rapports générés
backend/report.html
backend/benchmarks/*.html

# Artefacts de tests frontend
frontend/test-results/
