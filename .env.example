# Modèle de configuration locale.
# Copiez ce fichier vers `.env` (jamais versionné) puis adaptez les valeurs :
#   cp .env.example .env
# Générer un secret : python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Base de données (docker compose) ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=terminator_db

# --- API ---
# development | production (en production, l'API refuse de démarrer avec des secrets par défaut)
APP_ENV=development
SECRET_KEY=remplacez-moi-par-un-secret-de-64-caracteres
JWT_SECRET_KEY=remplacez-moi-par-un-autre-secret-de-64-caracteres
# Domaine des cookies de session, commun au frontend et à l'API (production : ex. terminator.fr). Vide en local.
# COOKIE_DOMAIN=
# Origines autorisées (séparées par des virgules)
CORS_ORIGINS=http://localhost:3000
# Temps maximum accordé au solveur pour une génération (secondes)
GENERATION_TIME_BUDGET_S=20
# Nombre de reverse proxys de confiance devant l'API (0 en local et derrière Cloudflare Tunnel)
TRUST_PROXY_HOPS=0
# En-tête portant l'adresse du visiteur, posé par un proxy de confiance : CF-Connecting-IP derrière
# Cloudflare Tunnel (ADR 0013). Vide en local : un client pourrait l'inventer pour échapper aux limites.
CLIENT_IP_HEADER=
# Générations calculées en même temps (une par cœur) ; une seule par visiteur, 429 au-delà
GENERATION_MAX_CONCURRENT=2
# Production (gunicorn) : nombre de workers, un de plus que GENERATION_MAX_CONCURRENT
# WEB_CONCURRENCY=3
# Stockage des compteurs de rate limiting (memory:// pour un seul processus, redis://... sinon)
RATELIMIT_STORAGE_URI=memory://
# Lexique utilisé par l'API (docker compose : lexique curé s'il existe, sinon DELA complet)
# LEXICON_PATH=/lexicon/lexique_cure.csv
# Vérification des changements du lexique, en secondes (0 : pas de rechargement à chaud ; ignoré
# en production, où le lexique est livré avec l'application)
LEXICON_RELOAD_INTERVAL_S=30

# --- E-mails du compte (ADR 0014) ---
# console : écrits dans le journal de l'API | smtp : envoyés (docker compose : Mailpit, http://localhost:8025)
# En production : le relais SMTP du prestataire (Brevo : smtp-relay.brevo.com, port 587, STARTTLS)
# MAIL_BACKEND=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Terminator <no-reply@votre-domaine.fr>
# Adresse du frontend dans les liens des e-mails (défaut : la première origine de CORS_ORIGINS)
# FRONTEND_URL=http://localhost:3000

# --- Sauvegardes (make db-backup, make db-restore-check) ---
# Clé publique age (age1...) : chiffre les sauvegardes. Obligatoire sur le serveur, qui n'a que cette clé.
# Créer la paire hors du serveur : age-keygen -o terminator-sauvegardes.key
BACKUP_AGE_RECIPIENT=
# Clé privée age, pour vérifier une sauvegarde chiffrée (jamais sur le serveur)
BACKUP_AGE_IDENTITY=
# Durée de conservation dans backups/, en jours
BACKUP_KEEP_DAYS=30

# --- Curateur du lexique (make curator) ---
# Code PIN demandé à l'ouverture, 6 caractères minimum (obligatoire)
CURATOR_PIN=
# Facultatif : clé de session fixe pour rester connecté après un redémarrage
CURATOR_SECRET_KEY=
# Facultatif : objectif de mots à trier par jour (100 par défaut)
CURATOR_DAILY_GOAL=100
# Facultatif : export du lexique curé (et rechargement par l'API) tous les N mots triés
CURATOR_EXPORT_EVERY=500
# Filtre appliqué au lexique exporté : « aucun » (défaut) ou « moyen » (mots connus de Lexique,
# définis pour eux-mêmes, ou formés sur un lemme courant). Les mots gardés à la main restent.
CURATOR_EXPORT_FILTER=aucun
# Facultatif : page de Terminator ouverte par « Tester mes grilles »
TERMINATOR_URL=http://localhost:3000/grid
# Facultatif : clé Serper (https://serper.dev, 2 500 recherches gratuites) pour afficher les résultats
# Google dans la bulle « Chercher ce mot ». Sans clé : Wikipédia et Wiktionnaire.
SERPER_API_KEY=
