# Configuration de production, lue par docker-compose.prod.yml (voir docs/PRODUCTION.md).
# Sur le serveur : cp .env.production.example .env.production, puis remplir. Jamais versionné.
# Générer un secret : python3 -c "import secrets; print(secrets.token_hex(32))"

# --- Base de données ---
POSTGRES_USER=leflechoir
POSTGRES_PASSWORD=
POSTGRES_DB=leflechoir

# --- Secrets de l'API : 32 octets au moins, différents l'un de l'autre ---
SECRET_KEY=
JWT_SECRET_KEY=

# --- Le site (ADR 0018) ---
CORS_ORIGINS=https://leflechoir.fr
COOKIE_DOMAIN=leflechoir.fr
FRONTEND_URL=https://leflechoir.fr
# SITE_NAME=Le Fléchoir

# --- E-mails du compte (Brevo : Paramètres → SMTP et API) ---
MAIL_FROM=Le Fléchoir <no-reply@leflechoir.fr>
SMTP_USER=
SMTP_PASSWORD=

# --- Tunnel Cloudflare (Zero Trust → Networks → Tunnels → le tunnel → jeton) ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Suivi des erreurs (Sentry, projet dans l'UE) : vide, rien n'est envoyé ---
SENTRY_DSN=

# --- Dossiers partagés par les versions (tools/deploy/server.sh) ---
LEXICON_DIR=/opt/leflechoir/lexicon

# --- Sauvegardes : clé publique age (age1...), la clé privée reste hors du serveur ---
BACKUP_AGE_RECIPIENT=

# La version déployée (RELEASE) est posée par le déploiement : ne pas la mettre ici.
